root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{js,html,css,json,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.{ps1,nsi,nsh}]
indent_style = space
indent_size = 2
end_of_line = crlf

[Makefile]
indent_style = tab
